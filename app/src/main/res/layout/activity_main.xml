<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="#0B0D12" android:fillViewport="true"><LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="LOCAL AI SERVER" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Galaxy Tab S6 Lite용 로컬 AI 엔진" android:textColor="#9EA4B3" android:textSize="14sp" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="● 서버 준비됨" android:textColor="#7CFFB2" android:textSize="17sp" android:layout_marginTop="28dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/modelUrl" android:hint="GGUF 모델 다운로드 URL" android:textColor="#FFFFFF" android:hintTextColor="#777D8B" android:singleLine="true" android:inputType="textUri" android:layout_marginTop="20dp" android:backgroundTint="#444957" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/modelName" android:hint="파일명 (예: model.gguf)" android:textColor="#FFFFFF" android:hintTextColor="#777D8B" android:singleLine="true" android:layout_marginTop="10dp" android:backgroundTint="#444957" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/download" android:text="모델 다운로드" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:visibility="gone" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/start" android:text="AI 서버 시작" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/stop" android:text="서버 중지" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/info" android:text="서버 주소: http://태블릿IP:8080\nOpenAI 호환 API: /v1/chat/completions" android:textColor="#C9CDD7" android:textSize="14sp" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="화면이 꺼져도 Foreground Service로 서버를 유지합니다. 배터리 최적화에서 이 앱을 제한하지 않는 것을 권장합니다." android:textColor="#777D8B" android:textSize="12sp" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
